<template>
  <div class="page">
    <text class="muyu-clock">{{ currentTime }}</text>
    <text class="muyu-num">{{ num }}</text>
    <text class="muyu-tip" style="opacity: {{ tipOpacity }};">{{ tipText }}</text>
    <image class="muyu-img" src="/common/images/muyu.png" onclick="handleClick"></image>
    <image class="muyu-stele" src="/common/images/fishsd.png"></image>
    <scroll class="wish-strip" scroll-x="true" bounces="false">
      <div class="wish-inner">
        <div class="wish-chip {{wishIndex == 0 ? 'wish-chip-selected' : ''}}" onclick="SetWish(0)"><text class="wish-chip-text">{{ $t("muyu.wish_0") }}</text></div>
        <div class="wish-chip {{wishIndex == 1 ? 'wish-chip-selected' : ''}}" onclick="SetWish(1)"><text class="wish-chip-text">{{ $t("muyu.wish_1") }}</text></div>
        <div class="wish-chip {{wishIndex == 2 ? 'wish-chip-selected' : ''}}" onclick="SetWish(2)"><text class="wish-chip-text">{{ $t("muyu.wish_2") }}</text></div>
        <div class="wish-chip {{wishIndex == 3 ? 'wish-chip-selected' : ''}}" onclick="SetWish(3)"><text class="wish-chip-text">{{ $t("muyu.wish_3") }}</text></div>
        <div class="wish-chip {{wishIndex == 4 ? 'wish-chip-selected' : ''}}" onclick="SetWish(4)"><text class="wish-chip-text">{{ $t("muyu.wish_4") }}</text></div>
        <div class="wish-chip {{wishIndex == 5 ? 'wish-chip-selected' : ''}}" onclick="SetWish(5)"><text class="wish-chip-text">{{ $t("muyu.wish_5") }}</text></div>
        <div class="wish-chip {{wishIndex == 6 ? 'wish-chip-selected' : ''}}" onclick="SetWish(6)"><text class="wish-chip-text">{{ $t("muyu.wish_6") }}</text></div>
      </div>
    </scroll>
  </div>
</template>

<script>
import vibrator from "@system.vibrator"
import { storage } from "@src/tsimports"

const MERIT_KEY = "muyu_merit"
const OLD_TOTAL_KEY = "muyu_total"
const WISH_KEY = "muyu_wish"
const WISH_COUNT = 7

export default {
  private: {
    currentTime: "00:00",
    num: 0,
    tipText: "",
    tipOpacity: 0,
    wishIndex: 0
  },
  onInit() {
    global.ui.InitPage(this)
    this.loadMerit()
    this.loadWish()
    this.UpdateClock()
    this.clockTimer = setInterval(() => {
      this.UpdateClock()
    }, 1000)
  },
  onDestroy() {
    if (this.clockTimer) {
      clearInterval(this.clockTimer)
    }
    if (this.tipTimer) {
      clearTimeout(this.tipTimer)
    }
  },
  UpdateClock() {
    const now = new Date()
    const pad = value => (value < 10 ? "0" + value : String(value))
    this.currentTime = pad(now.getHours()) + ":" + pad(now.getMinutes())
  },
  WishLabel() {
    const useEnglish = this.$t("worldclock.langCode") == "en"
    const zhNames = ["功德", "暴富", "上岸", "脱单", "健康", "平安", "好运"]
    const key = "muyu.wish_" + this.wishIndex
    return useEnglish ? this.$t(key) : zhNames[this.wishIndex]
  },
  handleClick() {
    this.num = this.num + 1
    this.saveMerit()
    try {
      vibrator.vibrate({ mode: "short" })
    } catch (e) {}
    this.tipText = this.WishLabel() + "+1"
    this.tipOpacity = 1
    if (this.tipTimer) {
      clearTimeout(this.tipTimer)
    }
    this.tipTimer = setTimeout(() => {
      this.tipOpacity = 0
    }, 800)
  },
  loadMerit() {
    storage.get({
      key: MERIT_KEY,
      success: res => {
        const parsed = parseInt(res || "0")
        if (!isNaN(parsed) && parsed > 0) {
          this.num = parsed
          return
        }
        // 迁移旧计数
        storage.get({
          key: OLD_TOTAL_KEY,
          success: old => {
            const oldNum = parseInt(old || "0")
            if (!isNaN(oldNum) && oldNum > 0) {
              this.num = oldNum
              this.saveMerit()
            }
          },
          fail: () => {}
        })
      },
      fail: () => {}
    })
  },
  saveMerit() {
    storage.set({
      key: MERIT_KEY,
      value: String(this.num)
    })
  },
  loadWish() {
    storage.get({
      key: WISH_KEY,
      success: data => {
        const parsed = parseInt(data)
        if (!isNaN(parsed) && parsed >= 0 && parsed < WISH_COUNT) {
          this.wishIndex = parsed
        }
      },
      fail: () => {}
    })
  },
  SetWish(index) {
    this.wishIndex = index
    storage.set({
      key: WISH_KEY,
      value: String(index)
    })
  }
}
</script>

<style lang="less">
@import "@less/global.less";
@import "./muyu.less";
</style>
