<import name="title-bar" src="@components/TitleBar/TitleBar.ux"></import>

<template>
  <div class="page">
    <scroll class="editor-scroll {{scrclass}}" scroll-y="true" bounces="false">
      <title-bar title="worldclock.editCities"></title-bar>
      <div class="editor-content">
        <scroll class="region-strip" scroll-x="true" bounces="false">
          <div class="region-inner">
            <div class="region-chip {{activeRegion == 'all' ? 'region-chip-selected' : ''}}" onclick="SetRegion('all')"><text class="region-chip-text">{{ $t("worldclock.regionAll") }}</text></div>
            <div class="region-chip {{activeRegion == 'asia' ? 'region-chip-selected' : ''}}" onclick="SetRegion('asia')"><text class="region-chip-text">{{ $t("worldclock.regionAsia") }}</text></div>
            <div class="region-chip {{activeRegion == 'europe' ? 'region-chip-selected' : ''}}" onclick="SetRegion('europe')"><text class="region-chip-text">{{ $t("worldclock.regionEurope") }}</text></div>
            <div class="region-chip {{activeRegion == 'africa' ? 'region-chip-selected' : ''}}" onclick="SetRegion('africa')"><text class="region-chip-text">{{ $t("worldclock.regionAfrica") }}</text></div>
            <div class="region-chip {{activeRegion == 'namerica' ? 'region-chip-selected' : ''}}" onclick="SetRegion('namerica')"><text class="region-chip-text">{{ $t("worldclock.regionNAmerica") }}</text></div>
            <div class="region-chip {{activeRegion == 'samerica' ? 'region-chip-selected' : ''}}" onclick="SetRegion('samerica')"><text class="region-chip-text">{{ $t("worldclock.regionSAmerica") }}</text></div>
            <div class="region-chip {{activeRegion == 'oceania' ? 'region-chip-selected' : ''}}" onclick="SetRegion('oceania')"><text class="region-chip-text">{{ $t("worldclock.regionOceania") }}</text></div>
          </div>
        </scroll>
        <text class="selected-count">{{ $t("worldclock.selected") }} {{ selectedKeys.length }} / {{ WORLD_TOTAL }}</text>
        <text class="editor-empty" if="{{visibleRows.length == 0}}">{{ $t("worldclock.noMatch") }}</text>
        <div class="city-row {{ $item.selected ? 'city-row-selected' : '' }}" for="{{visibleRows}}" onclick="ToggleCity($item)">
          <div class="city-copy">
            <text class="city-name">{{ $item.label }}</text>
            <text class="city-sub">{{ $item.sub }}</text>
          </div>
          <text class="city-check">{{ $item.selected ? '✓' : '' }}</text>
        </div>
        <div class="load-more" if="{{hiddenCount > 0}}" onclick="LoadMore">
          <text class="load-more-text">{{ $t("worldclock.loadMore") }} ({{ hiddenCount }}) </text>
        </div>
      </div>
      <text style="height: 30px"></text>
    </scroll>
  </div>
</template>

<script>
import { storage } from "@src/tsimports"
import { WORLD_COUNTRIES, DEFAULT_SELECTION, OffsetLabel } from "@src/worldcities.ts"

const CITIES_KEY = "worldclock_selected"
// 手表内存有限：列表分页渲染，避免一次性创建过多节点
const PAGE_SIZE = 25

export default {
  private: {
    scrclass: "",
    activeRegion: "all",
    selectedKeys: [],
    visibleRows: [],
    hiddenCount: 0,
    WORLD_TOTAL: WORLD_COUNTRIES.length
  },
  onInit() {
    global.ui.InitPage(this)
    this.LoadSelection()
  },
  LoadSelection() {
    storage.get({
      key: CITIES_KEY,
      success: data => {
        try {
          const parsed = JSON.parse(data)
          if (Array.isArray(parsed)) {
            const known = new Set(WORLD_COUNTRIES.map(country => country.key))
            this.selectedKeys = parsed.filter(key => known.has(key))
          }
        } catch (e) {
          this.selectedKeys = []
        }
        if (this.selectedKeys.length == 0) {
          this.selectedKeys = DEFAULT_SELECTION
        }
        this.RebuildRows()
      },
      fail: () => {
        this.selectedKeys = DEFAULT_SELECTION
        this.RebuildRows()
      }
    })
  },
  SaveSelection() {
    storage.set({
      key: CITIES_KEY,
      value: JSON.stringify(this.selectedKeys)
    })
  },
  SetRegion(region) {
    this.activeRegion = region
    this.RebuildRows()
  },
  RebuildRows(keepWindow) {
    const useEnglish = this.$t("worldclock.langCode") == "en"
    const selectedSet = {}
    for (const key of this.selectedKeys) {
      selectedSet[key] = true
    }
    const rows = WORLD_COUNTRIES.filter(country => {
      return this.activeRegion == "all" || country.region == this.activeRegion
    }).map(country => ({
      key: country.key,
      label: useEnglish ? country.en : country.zh,
      sub: (useEnglish ? country.zh : country.en) + " · " + OffsetLabel(country.offsetMinutes),
      selected: selectedSet[country.key] === true
    }))
    rows.sort((a, b) => {
      if (a.selected != b.selected) {
        return a.selected ? -1 : 1
      }
      return 0
    })
    // 完整结果留在普通属性上（不进可观察数据），页面只渲染前 renderLimit 行
    this.filteredRows = rows
    if (!keepWindow) {
      this.renderLimit = PAGE_SIZE
    }
    this.ApplyRenderWindow()
  },
  ApplyRenderWindow() {
    const rows = this.filteredRows || []
    this.visibleRows = rows.slice(0, this.renderLimit)
    this.hiddenCount = Math.max(0, rows.length - this.renderLimit)
  },
  LoadMore() {
    this.renderLimit = this.renderLimit + PAGE_SIZE
    this.ApplyRenderWindow()
  },
  ToggleCity(item) {
    const index = this.selectedKeys.indexOf(item.key)
    if (index >= 0) {
      // 至少保留一个国家
      if (this.selectedKeys.length == 1) {
        return
      }
      this.selectedKeys = this.selectedKeys.filter(key => key != item.key)
    } else {
      this.selectedKeys = this.selectedKeys.concat([item.key])
    }
    this.SaveSelection()
    // 勾选后保留当前滚动窗口，避免列表折叠回第一页
    this.RebuildRows(true)
  }
}
</script>

<style lang="less">
@import "@less/global.less";
@import "./editor.less";
</style>
