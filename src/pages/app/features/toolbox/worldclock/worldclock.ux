<import name="title-bar" src="@components/TitleBar/TitleBar.ux"></import>

<template>
  <div class="page">
    <scroll class="scroll {{scrclass}}" scroll-y="true" bounces="false">
      <title-bar title="worldclock.title"></title-bar>
      <div class="worldclock-content">
        <text class="worldclock-empty" if="{{cityRows.length == 0}}">{{ $t("worldclock.empty") }}</text>
        <div class="worldclock-row" for="{{cityRows}}">
          <div class="worldclock-copy">
            <text class="worldclock-city">{{ $item.label }}</text>
            <text class="worldclock-badge" if="{{ $item.badge }}">{{ $item.badge }}</text>
          </div>
          <div class="worldclock-time-copy">
            <text class="worldclock-time">{{ $item.time }}</text>
            <text class="worldclock-date">{{ $item.date }}</text>
          </div>
        </div>
        <div class="worldclock-edit" onclick="OpenEditor"><text class="worldclock-edit-text">{{ $t("worldclock.editCities") }}</text></div>
      </div>
      <text style="height: 30px"></text>
    </scroll>
  </div>
</template>

<script>
import router from "@system.router"
import { storage } from "@src/tsimports"
import { WORLD_COUNTRIES, DEFAULT_SELECTION, EffectiveOffset } from "@src/worldcities.ts"

const CITIES_KEY = "worldclock_selected"

export default {
  private: {
    scrclass: "",
    cityRows: [],
    selectedKeys: [],
    tickTimer: null
  },
  onInit() {
    global.ui.InitPage(this)
    this.LoadSelection()
  },
  onShow() {
    // 从编辑页返回时重新加载已选城市
    this.LoadSelection()
    if (!this.tickTimer) {
      this.tickTimer = setInterval(() => {
        this.RefreshTimes()
      }, 1000)
    }
  },
  onHide() {
    this.StopTimer()
  },
  onDestroy() {
    this.StopTimer()
  },
  StopTimer() {
    if (this.tickTimer) {
      clearInterval(this.tickTimer)
      this.tickTimer = null
    }
  },
  LoadSelection() {
    storage.get({
      key: CITIES_KEY,
      success: data => {
        try {
          const parsed = JSON.parse(data)
          if (Array.isArray(parsed)) {
            const known = new Set(WORLD_COUNTRIES.map(country => country.key))
            this.selectedKeys = parsed.filter(key => known.has(key))
          }
        } catch (e) {
          this.selectedKeys = []
        }
        if (this.selectedKeys.length == 0) {
          this.selectedKeys = DEFAULT_SELECTION
        }
        this.RefreshTimes()
      },
      fail: () => {
        this.selectedKeys = DEFAULT_SELECTION
        this.RefreshTimes()
      }
    })
  },
  OpenEditor() {
    router.push({ uri: "pages/app/features/toolbox/worldclock/editor" })
  },
  RefreshTimes() {
    if (this.selectedKeys.length == 0) {
      this.cityRows = []
      return
    }
    const useEnglish = this.$t("worldclock.langCode") == "en"
    const now = new Date()
    const localOffsetMinutes = -now.getTimezoneOffset()
    const localDateKey = this.DateKey(now)
    const selected = WORLD_COUNTRIES.filter(country => this.selectedKeys.indexOf(country.key) >= 0)
    selected.sort((a, b) => EffectiveOffset(b, now) - EffectiveOffset(a, now))
    const pad = value => (value < 10 ? "0" + value : String(value))
    this.cityRows = selected.map(city => {
      // 目标时区墙上时间 = 本地时刻 + 时区差，再用 getUTC* 读取
      const effOffset = EffectiveOffset(country, now)
      const zoned = new Date(now.getTime() + (effOffset - localOffsetMinutes) * 60000)
      const zonedDateKey = this.DateKeyUTC(zoned)
      let badge = ""
      if (effOffset == localOffsetMinutes) {
        badge = this.$t("worldclock.local")
      } else if (zonedDateKey > localDateKey) {
        badge = this.$t("worldclock.tomorrow")
      } else if (zonedDateKey < localDateKey) {
        badge = this.$t("worldclock.yesterday")
      }
      return {
        label: useEnglish ? country.en : country.zh,
        badge: badge,
        time: pad(zoned.getUTCHours()) + ":" + pad(zoned.getUTCMinutes()) + ":" + pad(zoned.getUTCSeconds()),
        date: pad(zoned.getUTCMonth() + 1) + "-" + pad(zoned.getUTCDate())
      }
    })
  },
  DateKey(value) {
    return value.getFullYear() + "-" + ("0" + (value.getMonth() + 1)).slice(-2) + "-" + ("0" + value.getDate()).slice(-2)
  },
  DateKeyUTC(value) {
    return value.getUTCFullYear() + "-" + ("0" + (value.getUTCMonth() + 1)).slice(-2) + "-" + ("0" + value.getUTCDate()).slice(-2)
  }
}
</script>

<style lang="less">
@import "@less/global.less";
@import "./worldclock.less";
</style>
